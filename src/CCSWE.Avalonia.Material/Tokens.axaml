  </ResourceDictionary.ThemeDictionaries>

  <!-- =====================================================================
       METRICS  (theme-invariant)
       ===================================================================== -->

  <!-- Shape scale (core shape) and the full-pill radius. -->
  <CornerRadius x:Key="CornerRadiusExtraSmall">4</CornerRadius>
  <CornerRadius x:Key="CornerRadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="CornerRadiusMedium">12</CornerRadius>
  <CornerRadius x:Key="CornerRadiusLarge">16</CornerRadius>
  <CornerRadius x:Key="CornerRadiusLargeIncreased">20</CornerRadius>
  <CornerRadius x:Key="CornerRadiusExtraLarge">28</CornerRadius>
  <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>

  <!-- Spacing scale: double and uniform Thickness. -->
  <x:Double x:Key="Spacing0">0</x:Double>
  <x:Double x:Key="Spacing1">4</x:Double>
  <x:Double x:Key="Spacing2">8</x:Double>
  <x:Double x:Key="Spacing3">12</x:Double>
