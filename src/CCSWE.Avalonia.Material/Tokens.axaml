      <Color x:Key="OnSuccessContainerColor">#FFFFFFFF</Color>
      <Color x:Key="WarningColor">#FF78350F</Color>
      <Color x:Key="OnWarningColor">#FFFFFFFF</Color>
      <Color x:Key="WarningContainerColor">#FF92400E</Color>
      <Color x:Key="OnWarningContainerColor">#FFFFFFFF</Color>
      <!-- Info (desktop status role) -->
