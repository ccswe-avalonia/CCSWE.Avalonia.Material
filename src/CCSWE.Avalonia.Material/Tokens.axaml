      <SolidColorBrush x:Key="SuccessContainer" Color="{StaticResource SuccessContainerColor}" />
      <SolidColorBrush x:Key="OnSuccessContainer" Color="{StaticResource OnSuccessContainerColor}" />
      <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
      <SolidColorBrush x:Key="OnWarning" Color="{StaticResource OnWarningColor}" />
      <SolidColorBrush x:Key="WarningContainer" Color="{StaticResource WarningContainerColor}" />
      <SolidColorBrush x:Key="OnWarningContainer" Color="{StaticResource OnWarningContainerColor}" />
      <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}" />
      <SolidColorBrush x:Key="OnInfo" Color="{StaticResource OnInfoColor}" />
      <SolidColorBrush x:Key="InfoContainer" Color="{StaticResource InfoContainerColor}" />
      <SolidColorBrush x:Key="OnInfoContainer" Color="{StaticResource OnInfoContainerColor}" />

      <!-- Alpha brushes -->
      <!-- OnSurface12: Disabled container fill and outline. -->
      <SolidColorBrush x:Key="OnSurface12" Color="{StaticResource OnSurfaceColor}" Opacity="0.12" />
      <!-- OnSurface38: Disabled content. -->
      <SolidColorBrush x:Key="OnSurface38" Color="{StaticResource OnSurfaceColor}" Opacity="0.38" />
      <!-- Scrim32: Modal and drawer backdrop. -->
      <SolidColorBrush x:Key="Scrim32" Color="{StaticResource ScrimColor}" Opacity="0.32" />
    </ResourceDictionary>

    <!-- ===================================================================
         LIGHT HIGH CONTRAST
         =================================================================== -->
    <ResourceDictionary x:Key="{x:Static material:MaterialTheme.LightHighContrast}">
