      <SolidColorBrush x:Key="OnSurface12" Color="{StaticResource OnSurfaceColor}" Opacity="0.12" />
      <!-- OnSurface38: Disabled content. -->
      <SolidColorBrush x:Key="OnSurface38" Color="{StaticResource OnSurfaceColor}" Opacity="0.38" />
      <!-- Scrim32: Modal and drawer backdrop. -->
