<views:GalleryPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:CCSWE.Avalonia.Material.Demo.Views"
             xmlns:vm="using:CCSWE.Avalonia.Material.Demo.ViewModels"
             x:Class="CCSWE.Avalonia.Material.Demo.Views.Pages.SelectionPage"
             x:DataType="vm:MainWindowViewModel">
        <StackPanel Spacing="24" Margin="32,24,32,48">
            <TextBlock Classes="HeadlineSmall" Text="Selection controls" />
            <Border Classes="Card Outlined">
                <WrapPanel ItemSpacing="48" LineSpacing="24">
                    <StackPanel Spacing="8">
                        <CheckBox Content="Unchecked" />
                        <CheckBox Content="Checked" IsChecked="True" />
                        <CheckBox Content="Indeterminate" IsThreeState="True" IsChecked="{x:Null}" />
                        <CheckBox Content="Disabled" IsEnabled="False" />
                        <CheckBox Content="Disabled checked" IsEnabled="False" IsChecked="True" />
                        <CheckBox Content="Disabled indeterminate" IsEnabled="False" IsThreeState="True" IsChecked="{x:Null}" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <RadioButton GroupName="g" Content="Option one" IsChecked="True" />
                        <RadioButton GroupName="g" Content="Option two" />
                        <RadioButton GroupName="g" Content="Option three" />
                    </StackPanel>
                    <StackPanel Spacing="12">
                        <ToggleSwitch Content="Wireless debugging" />
                        <ToggleSwitch Content="Connect automatically" IsChecked="True" />
                        <ToggleSwitch Content="Disabled" IsEnabled="False" />
                        <ToggleSwitch Content="Disabled on" IsEnabled="False" IsChecked="True" />
                        <ToggleSwitch Classes="Compact" Content=".Compact" />
                        <ToggleSwitch Classes="Compact" Content=".Compact on" IsChecked="True" />
                    </StackPanel>
                </WrapPanel>
            </Border>
        </StackPanel>
</views:GalleryPage>
